#include <dt-bindings/zmk/mouse.h>
#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

/*

   &mmv_input_listener {
       input-processors = <&zip_xy_scaler 2 1>;
   };

   &msc_input_listener {
       input-processors = <&zip_xy_scaler 2 1>;
   };

 */

#define ZMK_MOUSE_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_MOUSE_DEFAULT_SCRL_VAL 20    // 10

/ {
    behaviors {
        td0: td0 {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Shift/Caps Lock Tap Dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&kp CAPS>;
        };
    };

    rgb_encoder: rgb_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&rgb_ug RGB_BRI>, <&rgb_ug RGB_BRD>;
    };

    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <30>;
    };

    macros {
        hyperkey1: hyperkey1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LA(LC(LG(F1))))>;
            label = "HYPERKEY1";
        };
    };

    combos {
        compatible = "zmk,combos";

        macwin {
            bindings = <&tog 1>;
            key-positions = <41 1>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        mac {
            display-name = "QWERTY";
            bindings = <
&kp TAB         &kp Q  &kp W  &kp E         &kp R             &kp T                                                &kp LS(LA(LC(LG(F5))))                           &kp Y        &kp U      &kp I           &kp O    &kp P     &kp ESCAPE
&mo 2           &kp A  &kp S  &kp D         &kp F             &kp G                        &kp LS(LA(LC(LG(F2))))  &kp LS(LA(LC(LG(F1))))  &kp LS(LA(LC(LG(F16))))  &kp H        &kp J      &kp K           &kp L    &kp SEMI  &kp SQT
&kp LEFT_SHIFT  &kp Z  &kp X  &kp C         &kp V             &kp B          &kp C_MUTE                            &kp LS(LA(LC(LG(F4))))                           &kp N        &kp M      &kp COMMA       &kp DOT  &kp FSLH  &mo 3
                              &kp LEFT_ALT  &kp LEFT_CONTROL  &kp BACKSPACE                                                                                         &lt 4 ENTER  &kp SPACE  &kp RIGHT_META
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        windows {
            display-name = "QWERTY";
            bindings = <
&kp TAB         &kp Q  &kp W  &kp E             &kp R             &kp T                                                &kp LS(LA(LC(LG(F5))))                           &kp Y        &kp U      &kp I          &kp O    &kp P     &kp ESCAPE
&mo 2           &kp A  &kp S  &kp D             &kp F             &kp G                        &kp LS(LA(LC(LG(F2))))  &kp LS(LA(LC(LG(F1))))  &kp LS(LA(LC(LG(F16))))  &kp H        &kp J      &kp K          &kp L    &kp SEMI  &kp SQT
&kp LEFT_SHIFT  &kp Z  &kp X  &kp C             &kp V             &kp B          &kp C_MUTE                            &kp LS(LA(LC(LG(F4))))                           &kp N        &kp M      &kp COMMA      &kp DOT  &kp FSLH  &mo 3
                              &kp LEFT_CONTROL  &kp LEFT_COMMAND  &kp BACKSPACE                                                                                         &lt 4 ENTER  &kp SPACE  &kp RIGHT_ALT
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        nums {
            display-name = "NUMBER";
            bindings = <
&trans  &kp NUMBER_1     &kp N2          &kp N3           &kp N4           &kp N5                                         &mmv MOVE_UP                  &kp N6           &kp N7           &kp N8           &kp N9           &kp N0           &kp BSPC
&trans  &none            &none           &none            &none            &none                          &kp C_PREVIOUS  &kp C_PLAY_PAUSE  &kp C_NEXT  &kp LEFT         &kp DOWN         &kp UP_ARROW     &kp RIGHT        &none            &none
&trans  &rgb_ug RGB_OFF  &rgb_ug RGB_ON  &rgb_ug RGB_HUI  &rgb_ug RGB_HUD  &rgb_ug RGB_EFF  &kp C_MUTE                    &mmv MOVE_DOWN                &rgb_ug RGB_EFR  &rgb_ug RGB_SPI  &rgb_ug RGB_SPD  &rgb_ug RGB_BRI  &rgb_ug RGB_BRD  &trans
                                         &trans           &trans           &kp LEFT_SHIFT                                                               &kp INS          &kp DEL          &trans
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        symbols {
            display-name = "SYMBOL";
            bindings = <
&kp GRAVE  &trans      &tog 1      &trans      &trans     &trans                              &mmv MOVE_UP                     &kp CARET  &kp AMPS   &kp ASTRK  &kp LPAR  &kp RPAR  &kp TILDE
&trans     &trans      &mkp LCLK   &mkp MCLK   &mkp RCLK  &mkp MB4            &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &kp MINUS  &kp EQUAL  &kp LBKT   &kp RBKT  &kp BSLH  &kp GRAVE
&trans     &bt BT_CLR  &bt BT_NXT  &bt BT_PRV  &none      &mkp MB5  &trans                    &mmv MOVE_DOWN                   &kp UNDER  &kp PLUS   &kp LBRC   &kp RBRC  &kp PIPE  &trans
                                   &trans      &trans     &trans                                                               &kp RET    &trans     &trans
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        functions {
            display-name = "Fn";
            bindings = <
&studio_unlock  &kp F1      &kp F2     &kp F3       &kp F4     &kp F5                                  &mmv MOVE_UP                     &kp F6       &kp F7     &kp F8       &kp F9      &kp F10          &kp F11
&trans          &trans      &mkp LCLK  &mkp MCLK    &mkp RCLK  &mkp MB4                &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &bootloader  &mkp LCLK  &mkp MCLK    &mkp RCLK   &kp PRINTSCREEN  &kp F12
&trans          &sys_reset  &trans     &bootloader  &trans     &mkp MB5  &kp C_MUTE                    &mmv MOVE_DOWN                   &trans       &trans     &bootloader  &sys_reset  &kp SCROLLLOCK   &kp PAUSE_BREAK
                                       &trans       &trans     &trans                                                                   &trans       &trans     &trans
            >;

            sensor-bindings = <&inc_dec_kp C_AC_SCROLL_DOWN C_AC_SCROLL_UP>;
        };
    };
};
