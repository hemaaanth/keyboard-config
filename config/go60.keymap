/*
 * Starting Go60 port of the Eyelash Corne layout.
 * SPDX-License-Identifier: MIT
 */

#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

#define LAYER_Windows 0
#define LAYER_Mac 1
#define LAYER_Number 2
#define LAYER_Symbol 3
#define LAYER_Fn 4
#define LAYER_Magic 5
#define LAYER_Factory 6
#define LAYER_Paseo 7
#define VOICE_SHORTCUT LS(LA(LC(LG(F16))))
#define ZMK_MOUSE_DEFAULT_MOVE_VAL 1200
#define ZMK_MOUSE_DEFAULT_SCRL_VAL 20

/ {
    input_processors {
        zip_click_to_right_click_mapper: zip_click_to_right_click_mapper {
            compatible = "zmk,input-processor-code-mapper";
            #input-processor-cells = <0>;
            type = <INPUT_EV_KEY>;
            map = <INPUT_BTN_0 INPUT_BTN_1>;
        };
    };

    behaviors {
        magic: magic {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&rgb_ug_status_macro>;
        };

        td_shift_caps: td_shift_caps {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Shift/Caps Lock Tap Dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LSHFT>, <&kp CAPS>;
        };

        bt_0: bt_0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&bt_select_0>, <&bt BT_DISC 0>;
        };

        bt_1: bt_1 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&bt_select_1>, <&bt BT_DISC 1>;
        };

        bt_2: bt_2 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&bt_select_2>, <&bt BT_DISC 2>;
        };

        bt_3: bt_3 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&bt_select_3>, <&bt BT_DISC 3>;
        };

        // Paseo LEDs spike (config/paseo-leds): global-locality behavior the
        // central uses to push right-half number-row pixels to the
        // peripheral. Not bound in any layer -- invoked directly from C via
        // zmk_behavior_invoke_binding(). Node label kept <=8 chars: it's
        // sent over the split link as a behavior_dev string.
        pled: pled {
            compatible = "paseo,leds-invoke";
            #binding-cells = <2>;
        };

        // Paseo LEDs spike (config/paseo-leds): global Paseo-mode toggle,
        // bound directly below as &plt. Global locality so both halves
        // flip in lockstep. Node label kept <=8 chars, same reason as
        // `pled` above.
        plt: plt {
            compatible = "paseo,leds-toggle";
            #binding-cells = <0>;
        };

        micled: micled {
            compatible = "paseo,leds-mic";
            #binding-cells = <0>;
        };
    };

    // Paseo LEDs spike (config/paseo-leds): WS2812 strip indices for the
    // number row and home-row action keys, derived from go60_lh.dts's
    // underglow_indicators comment (left half) and a best-effort mirror of
    // that pattern (right half -- unverified, see
    // config/paseo-leds/src/paseo_leds.c for the full derivation).
    // left-number-row-indices / right-number-row-indices are
    // HARDWARE-VERIFIED -- do not change. left-extra-indices (order: F D)
    // and right-extra-indices (order: Y U J K L SEMI) extend the same
    // grid; correct the right-half array after on-hardware testing if the
    // wrong keys light up (see paseo_leds.c's derivation comment).
    paseo_leds: paseo-leds {
        compatible = "paseo,leds";
        left-number-row-indices = <22 17 12 7 3>;
        right-number-row-indices = <3 7 12 17 22>;
        left-extra-indices = <9 14>;
        right-extra-indices = <4 8 9 14 19 24>;
        right-mic-index = <2>;
    };

    macros {
        rgb_ug_status_macro: rgb_ug_status_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_STATUS>;
        };

        bt_select_0: bt_select_0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE &bt BT_SEL 0>;
        };

        bt_select_1: bt_select_1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE &bt BT_SEL 1>;
        };

        bt_select_2: bt_select_2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE &bt BT_SEL 2>;
        };

        bt_select_3: bt_select_3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE &bt BT_SEL 3>;
        };

        mic_ptt: mic_ptt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press &micled>,
                <&macro_press &kp LC(LG(LA(LS(F5))))>,
                <&macro_pause_for_release>,
                <&macro_release &kp LC(LG(LA(LS(F5))))>,
                <&macro_release &micled>;
        };
    };

    combos {
        compatible = "zmk,combos";

        macwin {
            bindings = <&tog LAYER_Mac>;
            key-positions = <49 55>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        windows {
            display-name = "Windows";
            bindings = <
&kp EQUAL         &kp N1  &kp N2                &kp N3     &kp N4   &kp N5                                                                                     &kp N6  &kp N7     &kp N8     &kp N9    &kp N0    &kp MINUS
&kp TAB           &kp Q   &kp W                 &kp E      &kp R    &kp T                                                                                      &kp Y   &kp U      &kp I      &kp O     &kp P     &kp ESCAPE
&mo LAYER_Number  &kp A   &kp S                 &kp D      &kp F    &kp G                                                                                      &kp H   &kp J      &kp K      &kp L     &kp SEMI  &kp SQT
&kp LSHFT         &kp Z   &kp X                 &kp C      &kp V    &kp B                                                                                      &kp N   &kp M      &kp COMMA  &kp DOT   &kp FSLH  &mo LAYER_Symbol
                          &magic LAYER_Magic 0  &kp GRAVE  &kp DEL                                                                                                     &kp RMETA  &kp LBKT   &kp RBKT
                                                                            &kp LCTRL  &kp BSPC  &mo LAYER_Paseo  &mic_ptt  &lt LAYER_Fn ENTER  &kp SPACE
            >;
        };

        mac {
            display-name = "Mac";
            bindings = <
&kp EQUAL         &kp N1  &kp N2                &kp N3     &kp N4   &kp N5                                                                          &kp N6  &kp N7              &kp N8     &kp N9    &kp N0    &kp MINUS
&kp TAB           &kp Q   &kp W                 &kp E      &kp R    &kp T                                                                           &kp Y   &kp U               &kp I      &kp O     &kp P     &kp ESCAPE
&mo LAYER_Number  &kp A   &kp S                 &kp D      &kp F    &kp G                                                                           &kp H   &kp J               &kp K      &kp L     &kp SEMI  &kp SQT
&kp LSHFT         &kp Z   &kp X                 &kp C      &kp V    &kp B                                                                           &kp N   &kp M               &kp COMMA  &kp DOT   &kp FSLH  &mo LAYER_Symbol
                          &magic LAYER_Magic 0  &kp GRAVE  &kp DEL                                                                                          &kp VOICE_SHORTCUT  &kp LBKT   &kp RBKT
                                                                            &kp LCTRL  &kp BSPC  &kp LALT  &kp RGUI  &lt LAYER_Fn ENTER  &kp SPACE
            >;
        };

        number {
            display-name = "Number";
            bindings = <
&trans  &kp N1     &kp N2     &kp N3     &kp N4     &kp N5                                                    &kp N6          &kp N7          &kp N8        &kp N9           &kp N0  &kp BSPC
&trans  &none      &none      &none      &none      &none                                                     &kp C_PREVIOUS  &kp C_PP        &kp C_NEXT    &none            &none   &none
&trans  &none      &none      &none      &none      &none                                                     &kp LEFT_ARROW  &kp DOWN        &kp UP_ARROW  &kp RIGHT        &none   &trans
&trans  &mkp LCLK  &mkp MCLK  &mkp RCLK  &mkp MB4   &mkp MB5                                                  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &none   &trans
                   &trans     &trans     &kp LSHFT                                                                            &none           &none         &trans
                                                              &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        symbol {
            display-name = "Symbol";
            bindings = <
&kp GRAVE  &trans      &tog LAYER_Mac  &trans      &trans     &trans                                                    &kp CARET       &kp AMPS   &kp ASTRK        &kp LPAR   &kp RPAR   &kp TILDE
&trans     &trans      &mkp LCLK       &mkp MCLK   &mkp RCLK  &mkp MB4                                                  &mmv MOVE_LEFT  &mkp LCLK  &mmv MOVE_RIGHT  &kp MINUS  &kp EQUAL  &kp GRAVE
&trans     &bt BT_CLR  &bt BT_NXT      &bt BT_PRV  &none      &mkp MB5                                                  &kp UNDER       &kp PLUS   &kp LBRC         &kp RBRC   &kp PIPE   &kp BSLH
&trans     &trans      &trans          &trans      &trans     &trans                                                    &mmv MOVE_DOWN  &kp COMMA  &kp DOT          &kp FSLH   &trans     &trans
                       &trans          &trans      &trans                                                                               &kp RET    &trans           &trans
                                                                        &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&studio_unlock  &kp F1      &kp F2     &kp F3       &kp F4     &kp F5                                                    &kp F6       &kp F7     &kp F8       &kp F9      &kp F10         &kp F11
&trans          &trans      &mkp LCLK  &mkp MCLK    &mkp RCLK  &mkp MB4                                                  &bootloader  &mkp LCLK  &mkp MCLK    &mkp RCLK   &kp PSCRN       &kp F12
&trans          &sys_reset  &trans     &bootloader  &trans     &mkp MB5                                                  &trans       &trans     &bootloader  &sys_reset  &kp SCROLLLOCK  &kp PAUSE_BREAK
&trans          &trans      &trans     &trans       &trans     &trans                                                    &trans       &trans     &trans       &trans      &trans          &trans
                            &trans     &trans       &trans                                                                            &trans     &trans       &trans
                                                                         &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        magic_layer {
            display-name = "Magic";
            bindings = <
&bt BT_CLR   &kp C_BRI_DN     &kp C_BRI_UP     &kp C_PREV       &kp C_NEXT       &kp C_PP                                                   &kp C_MUTE  &kp C_VOL_DN  &kp C_VOL_UP  &tog LAYER_Mac  &none  &bt BT_CLR_ALL
&bootloader  &rgb_ug RGB_SPI  &rgb_ug RGB_SAI  &rgb_ug RGB_HUI  &rgb_ug RGB_BRI  &rgb_ug RGB_TOG                                            &none       &none         &none         &none           &none  &bootloader
&sys_reset   &rgb_ug RGB_SPD  &rgb_ug RGB_SAD  &rgb_ug RGB_HUD  &rgb_ug RGB_BRD  &rgb_ug RGB_EFF                                            &none       &none         &none         &none           &none  &sys_reset
&none        &none            &bt_0            &bt_1            &bt_2            &bt_3                                                      &none       &none         &none         &none           &none  &to LAYER_Factory
                              &out OUT_USB     &none            &none                                                                                   &none         &none         &none
                                                                                                  &none  &none  &none  &none  &none  &none
            >;
        };

        factory {
            display-name = "Factory";
            bindings = <
&kp N0  &kp N4  &kp N8  &kp N3  &kp N8  &kp N3                                                  &kp N3  &kp N8  &kp N3  &kp N8  &kp N4  &kp N0
&kp N1  &kp N5  &kp N9  &kp N4  &kp N9  &kp N4                                                  &kp N4  &kp N9  &kp N4  &kp N9  &kp N5  &kp N1
&kp N2  &kp N6  &kp N0  &kp N5  &kp N0  &kp N5                                                  &kp N5  &kp N0  &kp N5  &kp N0  &kp N6  &kp N2
&kp N3  &kp N7  &kp N1  &kp N6  &kp N1  &kp N6                                                  &kp N6  &kp N1  &kp N6  &kp N1  &kp N7  &kp N3
                &kp N2  &kp N7  &kp N2                                                                  &kp N2  &kp N7  &kp N2
                                                &kp N7  &kp N8  &kp N9  &kp N9  &kp N8  &kp N7
            >;
        };

        paseo {
            display-name = "Agent Deck";
            // Held via the left thumb key on the desktop layer. Emits F13-F24
            // for the host bridge (bb-deck on Omarchy; AutoHotkey on Windows):
            //   1-0        -> F13-F22   jump to pinned agent slots 1-10
            //   Y / U      -> unassigned (bb interactions are usually free text)
            //   D          -> Shift+F23 focus the agent composer
            //   H          -> Shift+F17 usage-bar hotkey for the host bridge
            //   J/K/L/;    -> Shift+F13/F14/F15/F16  commit/push/pr/merge
            //   F          -> Shift+F24 focus the agent app window
            //   T          -> &plt      toggle host-driven LEDs (both halves)
            //   W / S      -> Shift+F18/F19  thinking effort up / down
            //   Q / A      -> Shift+F20/F21  mode up (toward bypass) / down (toward plan)
            bindings = <
&none  &kp F13      &kp F14      &kp F15  &kp F16      &kp F17                                            &kp F18      &kp F19      &kp F20      &kp F21      &kp F22  &none
&none  &kp LS(F20)  &kp LS(F18)  &none    &none        &plt                                               &none        &none        &none        &none        &none    &none
&none  &kp LS(F21)  &kp LS(F19)  &kp LS(F23) &kp LS(F24)  &none                                             &kp LS(F17)  &kp LS(F13)  &kp LS(F14)  &kp LS(F15)  &kp LS(F16)  &none
&none  &none    &none    &none    &none        &none                                                      &none        &none        &none        &none        &none    &none
                &none    &none    &none                                                                                &none        &none        &none
                                                            &none  &none  &none  &none  &none  &none
            >;
        };
    };
};

&cirque_rh_listener {
    input-processors = <&zip_xy_scaler 3 1>;

    layer_3 {
        layers = <LAYER_Symbol>;
        input-processors = <&zip_xy_scaler 9 1>;
    };
};

&cirque_lh_listener {
    input-processors =
        <&zip_xy_to_scroll_mapper>,
        <&zip_xy_scaler 1 8>,
        <&zip_click_to_right_click_mapper>;

    layer_6 {
        layers = <LAYER_Factory>;
        input-processors = <&zip_xy_scaler 3 1>;
    };
};
